#!/usr/bin/env bash
# buddha-screensaver hook for the Omarchy Buddha theme
# Omarchy runs every executable in ~/.config/omarchy/hooks/theme-set.d
# after a theme change, with the theme name in $1.

set -euo pipefail

theme_name="buddha"
config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy"
branding_dir="${config_dir}/branding"
branding="${branding_dir}/screensaver.txt"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/buddha-screensaver"

if [[ $# -lt 1 || -z ${1:-} ]]; then
  exit 0
fi

resolve_art() {
  local installed path_file theme_root
  installed="${config_dir}/themes/${theme_name}/screensaver.txt"
  if [[ -f $installed ]]; then
    printf '%s\n' "$installed"
    return 0
  fi

  path_file="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/buddha-screensaver.path"
  if [[ -f $path_file ]]; then
    theme_root="$(tr -d '\n' <"$path_file")"
    if [[ -n $theme_root && -f ${theme_root}/screensaver.txt ]]; then
      printf '%s\n' "${theme_root}/screensaver.txt"
      return 0
    fi
  fi

  printf '%s\n' "$installed"
}

art="$(resolve_art)"

files_match() {
  [[ -f $1 && -f $2 ]] && cmp -s "$1" "$2"
}

branding_is_ours() {
  if [[ ! -e $branding && ! -L $branding ]]; then
    return 0
  fi
  if [[ -f $art ]] && files_match "$branding" "$art"; then
    return 0
  fi
  if [[ ! -f $art ]]; then
    return 0
  fi
  return 1
}

apply_art() {
  if [[ ! -f $art ]]; then
    printf 'buddha-screensaver: %s is missing; leaving the branding screensaver unchanged.\n' "$art" >&2
    return 0
  fi

  mkdir -p "$branding_dir" "$state_dir"

  if [[ ! -f ${state_dir}/applied ]]; then
    if [[ -L $branding ]]; then
      readlink "$branding" >"${state_dir}/previous.link"
    elif [[ ! -e $branding ]]; then
      : >"${state_dir}/was-absent"
    elif files_match "$branding" "$art"; then
      : >"${state_dir}/already-same"
    else
      cp -a -- "$branding" "${state_dir}/previous.txt"
    fi
    : >"${state_dir}/applied"
  fi

  if [[ -L $branding ]]; then
    rm -- "$branding"
  fi
  if ! files_match "$branding" "$art"; then
    cp -a -- "$art" "$branding"
  fi
}

restore_art() {
  if [[ ! -f ${state_dir}/applied ]]; then
    return 0
  fi

  if branding_is_ours; then
    if [[ -f ${state_dir}/already-same ]]; then
      :
    elif [[ -f ${state_dir}/was-absent ]]; then
      rm -f -- "$branding"
    elif [[ -f ${state_dir}/previous.link ]]; then
      rm -f -- "$branding"
      ln -s -- "$(tr -d '\n' <"${state_dir}/previous.link")" "$branding"
    elif [[ -f ${state_dir}/previous.txt ]]; then
      mkdir -p "$branding_dir"
      rm -f -- "$branding"
      mv -- "${state_dir}/previous.txt" "$branding"
    fi
  else
    printf 'buddha-screensaver: %s changed while Buddha was active; leaving it in place.\n' "$branding" >&2
  fi

  rm -rf -- "$state_dir"
}

if [[ $1 == "$theme_name" ]]; then
  apply_art
else
  restore_art
fi
