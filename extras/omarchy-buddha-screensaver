#!/usr/bin/env bash
# omarchy-buddha-screensaver — rotate the Buddha theme's colored ASCII art through ttfx.

set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -L $source_path ]]; do
  link_dir="$(cd "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink -- "$source_path")"
  if [[ $source_path != /* ]]; then
    source_path="${link_dir}/${source_path}"
  fi
done

theme_dir="$(cd "$(dirname "$source_path")/.." && pwd)"
art_dir="${theme_dir}/screensavers"
fps="${BUDDHA_SCREENSAVER_FPS:-60}"
mode="${BUDDHA_SCREENSAVER_MODE:-shuffle}"

if [[ ! $fps =~ ^[1-9][0-9]*$ ]]; then
  printf 'BUDDHA_SCREENSAVER_FPS must be a positive integer, got %q.\n' "$fps" >&2
  exit 1
fi

if ! command -v ttfx >/dev/null 2>&1; then
  printf 'ttfx not found. It ships with Omarchy (TerminalTextEffects).\n' >&2
  exit 1
fi

shopt -s nullglob
mapfile -t arts < <(printf '%s\n' "${art_dir}"/*.ansi.txt | sort)
if ((${#arts[@]} == 0)); then
  printf 'No colored Buddha art in %s.\n' "$art_dir" >&2
  exit 1
fi

cleanup() {
  printf '\033[0m\033[?25h'
}
trap cleanup EXIT
trap 'exit 0' INT TERM HUP
printf '\033[?25l'

idx=0
count=${#arts[@]}
while true; do
  case "$mode" in
    ordered)
      art="${arts[$idx]}"
      idx=$(((idx + 1) % count))
      ;;
    shuffle)
      art="${arts[RANDOM % count]}"
      ;;
    *)
      printf 'Unknown BUDDHA_SCREENSAVER_MODE %q. Use ordered or shuffle.\n' "$mode" >&2
      exit 1
      ;;
  esac

  ttfx -i "$art" \
    --frame-rate "$fps" \
    --canvas-width 0 --canvas-height 0 \
    --reuse-canvas --anchor-canvas c --anchor-text c \
    --existing-color-handling dynamic \
    --random-effect --exclude-effects dev_worm \
    --no-eol --no-restore-cursor || true
done
